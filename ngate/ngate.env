# /opt/etc/ngate/ngate.env — настройки скриптов на стороне Entware
ROOT="/opt/debian"                             # chroot с Debian, CSP и NGate
NDM_IF="OpkgTun0"                              # интерфейс прошивки
NDM_DESC="NGATE"                               # название в веб-интерфейсе
IDLE_IP="192.0.2.1 255.255.255.255"            # заглушка, пока туннель не поднят
CSP_LICENSE=""    # серийный номер КриптоПро CSP; пусто — демо 90 дней
